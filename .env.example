# =============================================================================
# .env.example - SALIN menjadi .env lalu isi nilainya.
# File .env TIDAK boleh di-commit (sudah masuk .gitignore).
# =============================================================================

# Kunci API yang wajib dikirim backend website via header X-API-KEY
CHATBOT_API_KEY=ganti-dengan-token-acak-panjang

# URL database (default SQLite). Bisa diganti PostgreSQL/MySQL.
DATABASE_URL=sqlite:///./data/chatbot.db

# Kebijakan CORS: daftar origin website utama dipisah koma
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate limiting sederhana per IP/kunci (permintaan per menit)
RATE_LIMIT_PER_MINUTE=30

# Offline mode Hugging Face (OPSIONAL, hanya untuk huggingface_hub).
# 0 = boleh cek internet saat memuat model; 1 = pakai cache lokal saja.
# Model primer & embedder sudah ada di cache lokal, jadi tidak wajib diubah.
HF_HUB_OFFLINE=0
