# =============================================================================
# CONTOH SAJA - JANGAN DIJALANKAN tanpa izin pemilik proyek/server.
#
# Memasang layanan Windows = PERUBAHAN SISTEM (butuh Administrator) dan
# menjadikan proses PERMANEN. Baris `nssm install`/`start` di bawah sengaja
# dinonaktifkan (komentar).
#
# Prasyarat: unduh NSSM (https://nssm.cc) dan letakkan `nssm.exe` di PATH.
# =============================================================================

$ErrorActionPreference = "Stop"

$root        = "C:\Nitip Ragil\Chatbot"
$python      = Join-Path $root ".venv\Scripts\python.exe"
$serviceName = "chatbot-api"

if (-not (Test-Path $python)) {
    throw "Tidak menemukan virtualenv: $python"
}

# --- Perintah contoh (JANGAN diaktifkan tanpa izin) -------------------------
