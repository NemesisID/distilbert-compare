# =============================================================================
# deploy/env.production.example - CONTOH nilai .env untuk produksi.
# Salin menjadi .env di akar proyek lalu isi nilainya. JANGAN di-commit.
# =============================================================================

# Kunci API (WAJIB). Buat token acak panjang, mis.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
CHATBOT_API_KEY=GANTI-DENGAN-TOKEN-ACAK-PANJANG

# URL database. SQLite (default) atau PostgreSQL/MySQL via SQLAlchemy.
DATABASE_URL=sqlite:///./data/chatbot.db

# Origin website utama yang diizinkan (dipisah koma). Jangan pakai "*".
CORS_ORIGINS=https://inkubator.upnjatim.ac.id

# Batas permintaan per kunci/IP per menit.
RATE_LIMIT_PER_MINUTE=30

# Set 1 bila server tanpa internet dan cache HF sudah ada di models/hf_cache.
HF_HUB_OFFLINE=1
